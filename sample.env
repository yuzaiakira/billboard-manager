DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True

# MySQL (for docker-compose, DB_HOST is overridden to "db")
DB_NAME=billboard
DB_USER=billboard
DB_PASSWORD=billboard
DB_HOST=127.0.0.1
DB_PORT=3306

# Used by docker-compose MySQL service
DB_ROOT_PASSWORD=root

# Optional: host port for the web container
# WEB_PORT=8000

# If needed
# BASE_SITE_URL=/billboard
